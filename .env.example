# Frontend environment template
# Copy to .env.local (Next.js loads this automatically)

NEXT_PUBLIC_API_URL=http://localhost:4000

# Set to "true" once Google OAuth credentials are configured on the backend
# (see backend/.env.example). When false, the Google buttons render in a
# disabled "coming soon" state instead of redirecting to /auth/google.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# With Google OAuth configured on the backend, sign-in-with-Google becomes active
# in the login/register pages. The frontend just redirects the browser to:
#   {NEXT_PUBLIC_API_URL}/auth/google
# Nothing else needs to be set on the frontend for OAuth to work.