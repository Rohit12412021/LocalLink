# LocalLink NestJS Backend
# Copy to .env and fill in YOUR values. NEVER commit real passwords.

PORT=4000
CORS_ORIGIN=http://localhost:3000

# Base URL the API reports for its own static files (uploads/avatars).
# Locally: http://localhost:4000 — in production set your deployed backend URL.
PUBLIC_BASE_URL=http://localhost:4000

# Change this in production
JWT_SECRET=change-me-to-a-long-random-secret

# =============================================================================
# REQUIRED - PostgreSQL (no local/sqlite database)
# =============================================================================
# Paste your real connection URL below (Neon / Supabase / Railway / local):
#
# Password special characters MUST be URL-encoded in DATABASE_URL:
#   @ = %40   # = %23   % = %25   / = %2F   : = %3A   ? = %3F
#
# Example: password Rohit@54321 becomes Rohit%4054321
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# Example local:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/locallink
#
# OR use separate fields (instead of DATABASE_URL):
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=YOUR_PASSWORD
# DATABASE_NAME=locallink
# DATABASE_ENABLED=true

# Auto-create tables (set false later when you use migrations)
DATABASE_SYNC=true

# Set true for managed hosts that require SSL without sslmode in the URL
# DATABASE_SSL=true

# Optional: seed sample providers for empty DB (default OFF - real users register)
# SEED_DEMO=false

# =============================================================================
# OPTIONAL - Email Configuration (SMTP)
# =============================================================================
# If not provided, emails will use Ethereal test accounts (view at https://ethereal.email)
# For production, use a real SMTP service like Gmail, SendGrid, AWS SES, etc.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =============================================================================
# OPTIONAL - OAuth Configuration (Google Social Login)
# =============================================================================
# Get these from Google Cloud Console:
#   1. Create an OAuth client (type: Web application)
#   2. Add an authorized JavaScript origin = http://localhost:3000
#   3. Add an authorized redirect URI = http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# =============================================================================
# OPTIONAL - SMS (phone verification)
# =============================================================================
# Until an SMS provider is wired, phone codes are logged to the API console.
# SMS_PROVIDER=ethereal
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...